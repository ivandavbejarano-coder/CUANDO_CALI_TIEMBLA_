  m_Script: {fileID: 11500000, guid: cddd1de048c7bff47ad4b464487e6f55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GestorDialogos
  textoNombre: {fileID: 325842371}
  textoDialogo: {fileID: 1267464491}
  imagenPersonaje: {fileID: 1917217983}
  nombrePersonaje: luis
  escenaRegreso: Mapa_capitulo1
  velocidadEscritura: 0.03
  retrasoInicial: 1.3
  lineasDeDialogo:
  - expresionPersonaje: {fileID: 3262412965971147974, guid: d637b826acfdaf64eaa2cba4c351b839, type: 3}
    texto: " Luis regresaba a su apartamento en la torre de cali, hab\xEDa llegado
      hace unas semanas de venezuela, ten\xEDa por si acaso su mochila para emergencias
      que hab\xEDa armado luego del terremoto doble de hace unos meses. "
  - expresionPersonaje: {fileID: -6783473528798972689, guid: d637b826acfdaf64eaa2cba4c351b839, type: 3}
    texto: "Raz\xF3n por la cual termin\xF3 en Cali con parte de su familia a los
      alrededores de la torre donde est\xE1 alojando mientras encuentra otro sitio
      para vivir.\r\n "
  - expresionPersonaje: {fileID: 3262412965971147974, guid: d637b826acfdaf64eaa2cba4c351b839, type: 3}
    texto: 'En su mochila contaba con:agua y alimentos no perecederos para 72 horas,
      linterna, pilas, powerbank (bateria portatil para celular),

'
  - expresionPersonaje: {fileID: 3262412965971147974, guid: d637b826acfdaf64eaa2cba4c351b839, type: 3}
    texto: " radio, silbato, botiqu\xEDn y medicamentos, mascarillas, guantes, gafas,
      ropa de cambio, art\xEDculos de higiene, documentos y contactos de emergencia,
      efectivo y herramientas b\xE1sicas como cinta, cuerda y multiherramienta. \r\n"
