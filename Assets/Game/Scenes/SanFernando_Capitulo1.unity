--- !u!114 &382998569
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 382998568}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cddd1de048c7bff47ad4b464487e6f55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GestorDialogos
  textoNombre: {fileID: 1413273709}
  textoDialogo: {fileID: 1654626636}
  imagenPersonaje: {fileID: 1682661279}
  nombrePersonaje: Nicolas
  escenaRegreso: Mapa_capitulo1
  velocidadEscritura: 0.03
  retrasoInicial: 1.3
  lineasDeDialogo:
  - expresionPersonaje: {fileID: -1001641077158941355, guid: 8d75e9a63721b994f8018adb72c5a42e, type: 3}
    texto: "Maria atendi\xF3 a Nicol\xE1s, un joven amigo de la familia que llevaba
      10 a\xF1os con ella como su m\xE9dico principal, al verse en las cenas familiares
      y compartir juntos; ella le recordaba cuidarse y no tomar demasiado alcohol.\r\n"
  - expresionPersonaje: {fileID: 4521980677851409288, guid: 8d75e9a63721b994f8018adb72c5a42e, type: 3}
    texto: " Nicolas hab\xEDa sido hospitalizado por un accidente laboral unos pocos
      d\xEDas antes; en su momento Maria corri\xF3 apurada a buscarlo y atenderlo
      lo mejor posible.\r "
  - expresionPersonaje: {fileID: -5290163663872138316, guid: 63a2a117f4c714f4fb3cfafbf91b00da, type: 3}
    texto: "A pesar de tener la movilidad reducida en sus piernas, Nicol\xE1s se
      estaba recuperando; con un poco de fisioterapia saldr\xEDa nuevamente a vivir
      su vida, retomar sus estudios y tomar en navidad con Maria\r "
