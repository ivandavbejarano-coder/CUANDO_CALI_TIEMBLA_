  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GestorDialogos
  textoNombre: {fileID: 1094482262}
  textoDialogo: {fileID: 1725094694}
  imagenPersonaje: {fileID: 542009708}
  nombrePersonaje: Juan
  escenaRegreso: Mapa_capitulo1
  velocidadEscritura: 0.03
  retrasoInicial: 1.3
  lineasDeDialogo:
  - expresionPersonaje: {fileID: 0}
    texto: "Juan, un chico joven, reci\xE9n egresado de la universidad decidi\xF3
      llegar temprano a una fiesta para compartir junto a sus amigos; era una fiesta
      de despedida de soltero"
  - expresionPersonaje: {fileID: 0}
    texto: "El se iba a casar al d\xEDa siguiente en la tarde, sus amigos fueron
      llegando a saludarlo y compartir con \xE9l, llenos de risas fueron al lugar
      reservado, una bolichera para compartir la noche entre amigos. "
